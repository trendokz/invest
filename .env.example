# Скопируйте в .env и поменяйте под себя. Файл .env в git не попадает.

# Папка с данными: data.json (месяцы и инвесторы) и codes.json (коды входа).
# Для разработки и тестов — ./example (вымышленные данные из репозитория).
# Для продакшена — папка с реальными данными, которую передают отдельно, не через git.
TRENDO_DATA_DIR=./example

# Порт сайта на хосте
TRENDO_PORT=8080
